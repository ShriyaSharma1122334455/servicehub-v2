# =========================
# Server Configuration
# =========================
NODE_ENV=development
PORT=3000



# =========================
# Cloudinary
# =========================
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret


# =========================
# Resend Configuration
# =========================
RESEND_API_KEY=your_resend_api_key
FROM_EMAIL=your_from_email
FROM_NAME=your_app_name
SUPPORT_EMAIL=your_support_email


# =========================
# JWT Secret
# =========================
JWT_SECRET=your_jwt_secret


# =========================
# CORS
# =========================
CORS_ORIGIN=http://localhost:5173


# =========================
# Supabase (Frontend - Vite)
# =========================
VITE_SUPABASE_URL=your_supabase_url
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key
VITE_SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key


# =========================
# PostgreSQL
# =========================
# Running the backend on your machine against the Docker database (host port 5433).
# Inside Docker Compose this is overridden to use the service name: postgres:5432.
DATABASE_URL=postgres://servicehub:servicehub_dev_password@localhost:5433/servicehub_dev
# Optional: max connections in the pool (default 10)
# DB_POOL_MAX=10

# =========================
# Supabase (Backend) — being replaced by PostgreSQL
# =========================
SUPABASE_URL=your_supabase_url
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# =========================
# AI Services
# =========================
AI_SERVICES_URL=http://localhost:8001
AI_INTERNAL_API_KEY=change-me-in-production

# Visual Damage Assessment (FastAPI) — backend proxies here; never expose to browser
# Example: http://localhost:8000
VDA_SERVICE_URL=http://localhost:8000
# Shared secret sent by backend as X-Service-Token to protect /assess
VDA_SERVICE_API_KEY=replace_with_shared_secret

# Optional: Gemini API key for AI-ranked VDA service recommendations
# If unset, recommendations fall back to keyword heuristics only.
GEMINI_API_KEY=
# Optional override (Gemma model id served through Gemini API)
GEMMA_SERVICE_MATCH_MODEL=gemma-4-26b-a4b-it

# =========================
# Chatbot LLM (SER-AI)
# =========================
# Provider for the LLM-powered chatbot. Use "groq" (cloud, free tier) by default
# or "ollama" for local development. See the team Google Doc for the shared
# GROQ_API_KEY value, or create your own free key at https://console.groq.com.
LLM_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Optional Ollama fallback (only used if LLM_PROVIDER=ollama)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
